{
  "name": "@timbrix/mcp",
  "version": "0.5.0",
  "description": "MCP (Model Context Protocol) server for Timbrix — stamp, cancel and query CFDI 4.0 invoices from AI agents",
  "mcpName": "mx.timbrix/mcp",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "bin": {
    "timbrix-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/Timbrix/timbrix-platform.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://timbrix.mx",
  "author": "Ivan Sotelo",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "timbrix",
    "mcp",
    "cfdi",
    "model-context-protocol",
    "ai-agent",
    "ai-agents",
    "facturacion",
    "facturación",
    "mexico",
    "méxico",
    "anthropic"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@timbrix/sdk": "^2.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "ky": "^2.1.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^4.1.11",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
